{
  "manifest_version": 3,
  "name": "LinkedIn Auto-DM",
  "version": "1.0",
  "description": "Automates sending personalized DMs to new LinkedIn connections.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "options/options.html",
    "default_icon": {
      "48": "icons/lead_starter_48.png",
      "128": "icons/lead_starter_128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
      "48": "icons/lead_starter_48.png",
      "128": "icons/lead_starter_128.png"
  }
}
